{
  "name": "quickpickle-property",
  "version": "0.1.1",
  "type": "module",
  "description": "Property-based testing plugin for QuickPickle — express universal invariants in standard Gherkin",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:conformance": "vitest run --config vitest.conformance.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "prepublishOnly": "pnpm run build",
    "format:check": "prettier --check .",
    "coverage": "vitest run --config vitest.all.config.ts --coverage --coverage.lines=96 --reporter=default --reporter=junit --outputFile.junit=test-results.xml",
    "specdrive:install": "specdrive install",
    "specdrive:verify": "specdrive audit && specdrive verify test-results.xml"
  },
  "peerDependencies": {
    "fast-check": "^3.0.0",
    "quickpickle": "^1.0.0",
    "vitest": "^1.0.0 || >=2.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.0.0",
    "pixelmatch": "^7.1.0",
    "prettier": "^3.0.0",
    "quickpickle": "^1.11.0",
    "specdrive": "^0.1.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "quickpickle",
    "property-based-testing",
    "gherkin",
    "fast-check",
    "bdd",
    "pbt",
    "hypothesis",
    "invariant"
  ],
  "author": "Quickpickle Property Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerotechdebt/quickpickle-property.git"
  },
  "homepage": "https://github.com/zerotechdebt/quickpickle-property",
  "bugs": {
    "url": "https://github.com/zerotechdebt/quickpickle-property/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
